@model Ingredient
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-3">
    <div class="col-md-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="col-md-3"><label asp-for="Unit" class="form-label"></label>
        <select asp-for="Unit" class="form-select"><option>г</option><option>мл</option><option>шт</option></select></div>
    <div class="col-md-3"><label asp-for="PricePerUnit" class="form-label"></label><input asp-for="PricePerUnit" class="form-control" step="0.01" /><span asp-validation-for="PricePerUnit" class="text-danger small"></span></div>
    <div class="col-md-3"><label asp-for="Stock" class="form-label"></label><input asp-for="Stock" class="form-control" step="0.01" /><span asp-validation-for="Stock" class="text-danger small"></span></div>
    <div class="col-md-3"><label asp-for="MinStock" class="form-label"></label><input asp-for="MinStock" class="form-control" step="0.01" /></div>
    <div class="col-md-3"><label asp-for="ExpiryDate" class="form-label"></label><input asp-for="ExpiryDate" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="WarehouseId" class="form-label"></label><select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select"></select></div>
</div>
