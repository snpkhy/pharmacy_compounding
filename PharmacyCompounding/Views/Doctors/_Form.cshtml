@model Doctor
<input type="hidden" asp-for="Id" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Specialization" class="form-label"></label><input asp-for="Specialization" class="form-control" /></div>
    <div class="col-md-8"><label asp-for="Institution" class="form-label"></label><input asp-for="Institution" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="LicenseNumber" class="form-label"></label><input asp-for="LicenseNumber" class="form-control" /><span asp-validation-for="LicenseNumber" class="text-danger small"></span></div>
</div>
