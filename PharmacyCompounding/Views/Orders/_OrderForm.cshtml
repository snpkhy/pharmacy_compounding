@model OrderCreateViewModel
@* Shared by the new order and edit order pages: OrderEditViewModel derives from OrderCreateViewModel *@
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="panel mb-3">
            <div class="panel-head"><h2 class="panel-title"><i class="bi bi-file-earmark-medical"></i>Клієнт і рецепт лікаря</h2></div>
            <div class="panel-body row g-3">
                <div class="col-12">
                    <label asp-for="ClientId" class="form-label"></label>
                    <select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-select"></select>
                </div>
                <div class="col-12">
                    <label asp-for="DoctorId" class="form-label"></label>
                    <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="PrescriptionNumber" class="form-label"></label>
                    <input asp-for="PrescriptionNumber" class="form-control" placeholder="RX-2026-0001" />
                    <span asp-validation-for="PrescriptionNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Patient" class="form-label"></label>
                    <input asp-for="Patient" class="form-control" />
                    <span asp-validation-for="Patient" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IssueDate" class="form-label"></label>
                    <input asp-for="IssueDate" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ValidityDays" class="form-label"></label>
                    <input asp-for="ValidityDays" class="form-control" />
                    <span asp-validation-for="ValidityDays" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Formula" class="form-label"></label>
                    <textarea asp-for="Formula" class="form-control formula" rows="2" placeholder="Rp.: ..."></textarea>
                    <span asp-validation-for="Formula" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel mb-3">
            <div class="panel-head"><h2 class="panel-title"><i class="bi bi-capsule"></i>Позиція замовлення</h2></div>
            <div class="panel-body row g-3">
                <div class="col-12">
                    <label asp-for="MedicineName" class="form-label"></label>
                    <input asp-for="MedicineName" class="form-control" />
                    <span asp-validation-for="MedicineName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DosageForm" class="form-label"></label>
                    <select asp-for="DosageForm" class="form-select">
                        <option>Мазь</option><option>Розчин</option><option>Мікстура</option><option>Порошок</option><option>Супозиторії</option><option>Краплі</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Dosage" class="form-label"></label>
                    <input asp-for="Dosage" class="form-control" placeholder="50 г" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="WorkCost" class="form-label"></label>
                    <input asp-for="WorkCost" class="form-control" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PlannedReadyDate" class="form-label"></label>
                    <input asp-for="PlannedReadyDate" class="form-control" />
                </div>
            </div>
        </div>
        <div class="panel mb-3">
            <div class="panel-head"><h2 class="panel-title"><i class="bi bi-box-seam"></i>Компоненти зі складу</h2><span class="small text-muted">інгредієнт і кількість</span></div>
            <div class="panel-body">
                @for (var i = 0; i < Model.Components.Count; i++)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <select asp-for="Components[i].IngredientId" asp-items="ViewBag.Ingredients" class="form-select">
                                <option value="">— не обрано —</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <input asp-for="Components[i].Amount" class="form-control" step="0.01" placeholder="кількість" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
