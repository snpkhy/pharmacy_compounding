@model OrderCreateViewModel
@{
    ViewData["Title"] = "Нове замовлення";
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="small fw-semibold"><i class="bi bi-arrow-left"></i> Замовлення</a>
        <h1 class="mt-1">Нове замовлення</h1>
        <div class="sub">Оформлення замовлення на виготовлення ліків за рецептом лікаря</div>
    </div>
</div>

<form asp-action="Create" method="post">
    <partial name="_OrderForm" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-brand"><i class="bi bi-check2 me-1"></i>Оформити замовлення</button>
        <a asp-action="Index" class="btn btn-soft">Скасувати</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
