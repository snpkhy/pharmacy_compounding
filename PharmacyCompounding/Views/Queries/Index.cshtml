@{
    ViewData["Title"] = "Запити";
    var groups = new[]
    {
        ("Відбір даних за умовою", "bi-funnel", new[]
        {
            ("Orders", 1, "Замовлення за період", "Фільтр за датою, статусом і клієнтом"),
            ("Doctors", 2, "Лікарі та їхні рецепти", "Спеціалізація, кількість рецептів (синтаксис запитів LINQ)"),
            ("Shortages", 3, "Проблемні залишки", "Нижче мінімуму, прострочені або скоро спливають"),
        }),
        ("Узагальнення даних", "bi-calculator", new[]
        {
            ("Revenue", 4, "Виручка за період", "День, місяць або півріччя; розбивка за способом оплати"),
            ("Monthly", 5, "Виручка по місяцях", "GroupBy за роком і місяцем: сума, середня, найбільша"),
            ("Consumption", 6, "Витрата інгредієнтів", "join чотирьох таблиць і групування за інгредієнтом"),
            ("Technologists", 7, "Робота технологів", "Акти виготовлення, брак і частка браку"),
            ("Cost", 8, "Собівартість ліків (PLINQ)", "Паралельне обчислення в пам'яті через AsParallel()"),
        }),
        ("Доповнення, зміна, вилучення", "bi-pencil-square", new[]
        {
            ("AddDoctor", 9, "Додати лікаря", "INSERT у таблицю doctors"),
            ("Reprice", 10, "Переоцінка інгредієнтів", "UPDATE цін складу на вказаний відсоток"),
            ("Cleanup", 11, "Очищення скасованих замовлень", "DELETE старих скасованих замовлень і їхніх рецептів"),
        }),
    };
}
<div class="page-head">
    <div>
        <h1>Запити</h1>
        <div class="sub">LINQ-запити до бази даних PostgreSQL: для кожного показано результат і згенерований SQL</div>
    </div>
</div>

@foreach (var (title, icon, queries) in groups)
{
    <h2 class="query-group"><i class="bi @icon"></i>@title</h2>
    <div class="row g-3 mb-4">
        @foreach (var (action, number, name, hint) in queries)
        {
            <div class="col-md-6 col-xl-4">
                <a class="panel query-card" asp-action="@action">
                    <span class="query-no">@number</span>
                    <span>
                        <span class="cell-title d-block">@name</span>
                        <span class="cell-sub">@hint</span>
                    </span>
                </a>
            </div>
        }
    </div>
}
