@model RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація";
    Layout = "_AuthLayout";
}
<h1 class="auth-title">Реєстрація клієнта</h1>
<p class="auth-sub">Після реєстрації ви зможете стежити за виготовленням своїх ліків</p>
<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="flash flash-error"></div>
    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" autofocus /><span asp-validation-for="FullName" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="+380" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
    <div class="row g-3 mb-3">
        <div class="col-sm-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
        <div class="col-sm-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
    </div>
    <button class="btn btn-brand w-100">Зареєструватися</button>
</form>
<div class="auth-foot">Вже маєте обліковий запис? <a asp-action="Login">Увійти</a></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
