@model IEnumerable<Prescription>
@{
    ViewData["Title"] = "Рецепти";
    var current = (int)ViewBag.Page;
    var pages = (int)ViewBag.Pages;
}
<div class="page-head">
    <div><h1>Рецепти</h1><div class="sub">Рецепти, подані разом із замовленнями</div></div>
</div>
<div class="panel">
<form asp-action="Index" method="get" class="toolbar">
    <div class="search">
        <i class="bi bi-search"></i>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Номер рецепта або пацієнт" />
    </div>
    <button class="btn btn-soft">Знайти</button>
    <span class="ms-auto text-muted small">Знайдено: @(((int)ViewBag.Total).ToString("N0"))</span>
</form>
<table class="table table-hover align-middle">
    <thead><tr><th>Рецепт</th><th>Лікар</th><th>Пацієнт</th><th>Пропис</th><th>Дійсність</th><th>Замовлення</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><div class="cell-title num">@p.Number</div><div class="cell-sub">від @p.IssueDate.ToString("dd.MM.yyyy")</div></td>
            <td><div>@p.Doctor?.FullName</div><div class="cell-sub">@p.Doctor?.Specialization</div></td>
            <td>@p.Patient</td>
            <td><span class="formula small">@p.Formula</span></td>
            <td>@if (p.IsValid(DateTime.Today)) { <span class="pill st-ok">дійсний</span> } else { <span class="pill st-bad">прострочений</span> }</td>
            <td>@if (p.Order != null) { <a class="order-no" asp-controller="Orders" asp-action="Details" asp-route-id="@p.Order.Id">#@p.Order.Number</a> }</td>
            <td class="text-end">
                @* A prescription is edited together with its order, until the pharmacist has verified it *@
                @if (p.Order is { IsEditable: true } && User.CanEdit())
                {
                    <a class="btn btn-soft btn-icon" title="Змінити" asp-controller="Orders" asp-action="Edit" asp-route-id="@p.Order.Id"><i class="bi bi-pencil"></i></a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (pages > 1)
{
    <div class="toolbar justify-content-between border-0 border-top">
        <a class="btn btn-soft btn-sm @(current == 1 ? "disabled" : "")" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(current - 1)"><i class="bi bi-chevron-left"></i> Попередня</a>
        <span class="text-muted small">Сторінка @current з @pages.ToString("N0")</span>
        <a class="btn btn-soft btn-sm @(current == pages ? "disabled" : "")" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(current + 1)">Наступна <i class="bi bi-chevron-right"></i></a>
    </div>
}
</div>
