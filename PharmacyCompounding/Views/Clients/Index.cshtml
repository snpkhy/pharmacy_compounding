@model IEnumerable<Client>
@{ ViewData["Title"] = "Клієнти"; }
<div class="page-head">
    <div><h1>Клієнти</h1><div class="sub">Зареєстровані клієнти аптеки</div></div>
    <a class="btn btn-brand" asp-action="Create"><i class="bi bi-person-plus me-1"></i>Зареєструвати клієнта</a>
</div>
<div class="panel">
<table class="table table-hover align-middle">
    <thead><tr><th>Клієнт</th><th>Контакти</th><th>Адреса</th><th class="text-end">Замовлень</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>
                <div class="d-flex align-items-center gap-2">
                    <partial name="_Initials" model="c.FullName" />
                    <div><div class="cell-title">@c.FullName</div><div class="cell-sub">@c.BirthDate?.ToString("dd.MM.yyyy")</div></div>
                </div>
            </td>
            <td><div>@c.Phone</div><div class="cell-sub">@c.Email</div></td>
            <td class="text-muted">@c.Address</td>
            <td class="text-end"><a class="fw-semibold" asp-controller="Orders" asp-action="Index" asp-route-search="@c.FullName">@c.Orders.Count</a></td>
            <td class="text-end text-nowrap">
                <a class="btn btn-soft btn-icon" title="Змінити" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i></a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Видалити клієнта?')">
                    <button class="btn btn-ghost-danger btn-icon" title="Видалити"><i class="bi bi-trash3"></i></button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
