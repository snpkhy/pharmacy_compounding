<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Рецептурна аптека</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">
<div class="auth-wrap">
    <div class="auth-brand">
        <span class="brand-mark">℞</span>
        <span>
            <span class="brand-title">Рецептурна аптека</span>
            <span class="brand-sub">облік виготовлення ліків</span>
        </span>
    </div>
    <div class="panel auth-card">
        @if (TempData["Message"] is string msg)
        {
            <div class="flash flash-success"><i class="bi bi-check-circle-fill"></i><span>@msg</span></div>
        }
        @RenderBody()
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
