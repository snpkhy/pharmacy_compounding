@model ClientOrderViewModel
@{ ViewData["Title"] = "Нове замовлення"; }
<div class="page-head">
    <div>
        <a asp-action="Index" class="small fw-semibold"><i class="bi bi-arrow-left"></i> Мої замовлення</a>
        <h1 class="mt-1">Нове замовлення</h1>
        <div class="sub">Перепишіть дані з рецепта лікаря. Провізор перевірить рецепт, визначить склад і розрахує вартість</div>
    </div>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="panel mb-3">
                <div class="panel-head"><h2 class="panel-title"><i class="bi bi-file-earmark-medical"></i>Рецепт лікаря</h2></div>
                <div class="panel-body row g-3">
                    <div class="col-12">
                        <label asp-for="DoctorId" class="form-label"></label>
                        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select">
                            <option value="0">— оберіть лікаря —</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrescriptionNumber" class="form-label"></label>
                        <input asp-for="PrescriptionNumber" class="form-control" placeholder="RX-2026-0001" />
                        <span asp-validation-for="PrescriptionNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Patient" class="form-label"></label>
                        <input asp-for="Patient" class="form-control" />
                        <span asp-validation-for="Patient" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IssueDate" class="form-label"></label>
                        <input asp-for="IssueDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ValidityDays" class="form-label"></label>
                        <input asp-for="ValidityDays" class="form-control" />
                        <span asp-validation-for="ValidityDays" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Formula" class="form-label"></label>
                        <textarea asp-for="Formula" class="form-control formula" rows="3" placeholder="Rp.: ..."></textarea>
                        <span asp-validation-for="Formula" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel mb-3">
                <div class="panel-head"><h2 class="panel-title"><i class="bi bi-capsule"></i>Що виготовити</h2></div>
                <div class="panel-body row g-3">
                    <div class="col-12">
                        <label asp-for="MedicineName" class="form-label"></label>
                        <input asp-for="MedicineName" class="form-control" />
                        <span asp-validation-for="MedicineName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DosageForm" class="form-label"></label>
                        <select asp-for="DosageForm" class="form-select">
                            <option>Мазь</option><option>Розчин</option><option>Мікстура</option><option>Порошок</option><option>Супозиторії</option><option>Краплі</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Dosage" class="form-label"></label>
                        <input asp-for="Dosage" class="form-control" placeholder="50 г" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label"></label>
                        <input asp-for="Quantity" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="panel mb-3">
                <div class="panel-body small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Після перевірки рецепта в замовленні з'явиться сума, і його можна буде оплатити онлайн.
                    Скасувати замовлення можна до оплати.
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-brand"><i class="bi bi-send me-1"></i>Оформити замовлення</button>
        <a asp-action="Index" class="btn btn-soft">Скасувати</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
