@model ProfileViewModel
@{ ViewData["Title"] = "Профіль"; }
<div class="page-head">
    <div>
        <div class="eyebrow">Особистий кабінет</div>
        <h1>Профіль</h1>
        <div class="sub">Контактні дані, за якими аптека повідомляє про готовність ліків</div>
    </div>
</div>
<form asp-action="Profile" method="post">
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="panel h-100">
                <div class="panel-head"><h2 class="panel-title"><i class="bi bi-person"></i>Особисті дані</h2></div>
                <div class="panel-body row g-3">
                    <div class="col-12"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" readonly /></div>
                    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" placeholder="+380" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
                    <div class="col-md-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="BirthDate" class="form-label"></label><input asp-for="BirthDate" class="form-control" /></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="panel h-100">
                <div class="panel-head"><h2 class="panel-title"><i class="bi bi-key"></i>Зміна пароля</h2><span class="small text-muted">необов'язково</span></div>
                <div class="panel-body row g-3">
                    <div class="col-12"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger small"></span></div>
                    <div class="col-12"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
                    <div class="col-12"><label asp-for="ConfirmNewPassword" class="form-label"></label><input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3"><button class="btn btn-brand"><i class="bi bi-check2 me-1"></i>Зберегти</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
